<div class="p-4 md:p-6 max-w-7xl mx-auto">
  <!-- Header Section - Enhanced -->
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
    <div class="flex items-center gap-3">
      <div class="bg-gradient-to-br from-blue-500 to-indigo-600 p-2.5 rounded-xl shadow-lg shadow-blue-200/50">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-gray-800 tracking-tight">Lease & Membership Manager</h1>
        <p class="text-sm text-gray-500 hidden sm:block">Manage all property memberships and leases</p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 text-gray-700 px-5 py-2.5 rounded-xl text-sm font-semibold shadow-sm border border-blue-100/50 flex items-center gap-2">
        <span class="text-blue-600">●</span>
        <span>Active Records: <span class="text-blue-700 font-bold"><%= length(@memberships) %></span></span>
      </div>
    </div>
  </div>

  <!-- 🔍 Search Bar - Refined -->
  <div class="mb-6">
    <form phx-change="search" class="flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          type="text"
          name="search"
          value={@search}
          placeholder="Search by user, email, apartment, or unit..."
          phx-debounce="300"
          class="w-full border-2 border-gray-200 rounded-xl pl-10 pr-4 py-3 text-sm focus:ring-4 focus:ring-blue-200/50 focus:border-blue-400 focus:outline-none transition-all duration-200 bg-gray-50/50 hover:bg-white"
        />
        <%= if @search != "" do %>
          <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
            <span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full"><%= length(@memberships) %> results</span>
          </div>
        <% end %>
      </div>

      <!-- Clear Button - Enhanced -->
      <button
        type="button"
        phx-click="search"
        phx-value-search=""
        class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-3 rounded-xl text-sm font-medium transition-all duration-200 hover:shadow-md flex items-center gap-2 whitespace-nowrap"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        Clear Filters
      </button>
    </form>
  </div>

  <!-- Stats Bar -->
  <div class="flex flex-wrap items-center gap-4 mb-4 text-xs text-gray-500">
    <span class="flex items-center gap-1">
      <span class="w-2 h-2 bg-green-400 rounded-full"></span>
      Active: <span class="font-semibold text-gray-700"><%= length(@memberships) %></span>
    </span>
    <span class="text-gray-300">|</span>
    <span class="flex items-center gap-1">
      <span class="w-2 h-2 bg-blue-400 rounded-full"></span>
      Admins: <span class="font-semibold text-gray-700"><%= Enum.count(@memberships, &(&1.role && &1.role.name == "admin")) %></span>
    </span>
    <span class="text-gray-300">|</span>
    <span class="flex items-center gap-1">
      <span class="w-2 h-2 bg-purple-400 rounded-full"></span>
      Members: <span class="font-semibold text-gray-700"><%= Enum.count(@memberships, &(&1.role && &1.role.name == "member")) %></span>
    </span>
  </div>

  <!-- Cards Container - Enhanced Design -->
  <div class="space-y-3">
    <%= for ua <- @memberships do %>
      <div class="group bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-xl hover:border-blue-200 transition-all duration-300 hover:scale-[1.002]">
        <!-- Main row: fits on any screen width -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between p-4 gap-3">
          
          <!-- Left side: User + Apartment info -->
          <div class="flex-1 min-w-0">
            <div class="flex flex-col sm:flex-row sm:items-center gap-3">
              
              <!-- User avatar + name -->
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center text-white font-bold text-sm shadow-md shadow-blue-200/50 flex-shrink-0">
                  <%= String.first(ua.user.first_name || "U") %>
                </div>
                <div>
                  <div class="font-semibold text-gray-800 text-sm leading-tight">
                    <%= ua.user.first_name %> <%= ua.user.last_name %>
                  </div>
                  <div class="text-xs text-gray-400 truncate max-w-[160px] sm:max-w-none">
                    <%= ua.user.email %>
                  </div>
                </div>
              </div>
              
              <!-- Separator -->
              <div class="hidden sm:flex items-center text-gray-300">|</div>
              
              <!-- Apartment info -->
              <div class="flex items-center flex-wrap gap-2">
                <span class="font-bold text-gray-800 text-sm bg-gray-50 px-3 py-1 rounded-lg border border-gray-100">
                  🏢 <%= ua.apartment.name %>
                </span>
                
                <!-- Floor (if exists) -->
                <%= if ua.floor do %>
                  <span class="inline-flex items-center gap-1 text-indigo-600 text-xs bg-indigo-50 px-2.5 py-1 rounded-lg border border-indigo-100/50">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                    </svg>
                    <%= ua.floor.name %>
                  </span>
                <% end %>
                
                <!-- Unit (if exists) -->
                <%= if ua.unit do %>
                  <span class="font-mono text-xs bg-gradient-to-r from-gray-50 to-gray-100 text-gray-700 px-2.5 py-1 rounded-lg border border-gray-200">
                    Unit <%= ua.unit.name %>
                  </span>
                <% else %>
                  <span class="text-gray-400 text-xs bg-gray-50 px-2.5 py-1 rounded-lg border border-gray-100 italic">
                    Entire Building
                  </span>
                <% end %>
              </div>
            </div>
          </div>
          
          <!-- Right side: Role + Actions -->
          <div class="flex items-center justify-between lg:justify-end gap-4 border-t lg:border-t-0 pt-3 lg:pt-0 mt-2 lg:mt-0">
            <!-- Role badge - Enhanced -->
            <span class={[
              "px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap shadow-sm flex items-center gap-1.5",
              ua.role && ua.role.name == "admin" && "bg-gradient-to-r from-blue-50 to-indigo-50 text-blue-700 border border-blue-200",
              ua.role && ua.role.name == "member" && "bg-gradient-to-r from-purple-50 to-pink-50 text-purple-700 border border-purple-200",
              !ua.role && "bg-gradient-to-r from-gray-50 to-yellow-50 text-yellow-700 border border-yellow-200"
            ]}>
              <span class={[
                "w-1.5 h-1.5 rounded-full",
                ua.role && ua.role.name == "admin" && "bg-blue-500",
                ua.role && ua.role.name == "member" && "bg-purple-500",
                !ua.role && "bg-yellow-500"
              ]}></span>
              <%= if ua.role, do: String.upcase(ua.role.name), else: "PENDING" %>
            </span>
            
            <!-- Action buttons -->
            <div class="flex items-center gap-1">
              <.link 
                navigate={~p"/apartments/#{ua.apartment.id}"} 
                class="text-gray-600 hover:text-blue-600 text-xs font-medium px-3 py-1.5 rounded-lg hover:bg-blue-50 transition-all duration-200 flex items-center gap-1"
              >
                View
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </.link>
              <div class="w-px h-6 bg-gray-200"></div>
              <button 
                phx-click="delete_membership" 
                phx-value-id={ua.id} 
                class="text-gray-400 hover:text-red-500 hover:bg-red-50 p-1.5 rounded-lg transition-all duration-200"
                title="Remove membership"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    
    <!-- Empty state - Enhanced -->
    <%= if Enum.empty?(@memberships) do %>
      <div class="text-center py-16 bg-white rounded-2xl border-2 border-dashed border-gray-200">
        <div class="w-20 h-20 mx-auto bg-gradient-to-br from-gray-50 to-gray-100 rounded-2xl flex items-center justify-center mb-4">
          <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <p class="text-gray-400 text-sm font-medium">No memberships found</p>
        <p class="text-gray-300 text-xs mt-1">Try adjusting your search filters</p>
      </div>
    <% end %>
  </div>
</div>